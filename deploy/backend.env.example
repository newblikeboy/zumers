APP_ENV=production
APP_PORT=8080
APP_BASE_URL=https://YOUR_DOMAIN_OR_IP
FRONTEND_URL=https://YOUR_DOMAIN_OR_IP

POSTGRES_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=zumers-prod
CLOUDINARY_MAX_IMAGE_BYTES=10485760
CLOUDINARY_MAX_VIDEO_BYTES=209715200
CLOUDINARY_MAX_VIDEO_SECONDS=300
